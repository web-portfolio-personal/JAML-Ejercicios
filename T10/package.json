{
  "name": "t10-chat-realtime",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --env-file=.env --watch src/index.js",
    "start": "node --env-file=.env src/index.js",
    "seed": "node --env-file=.env seed.js",
    "test": "node --env-file=.env --experimental-vm-modules node_modules/jest/bin/jest.js --forceExit --runInBand",
    "test:watch": "node --env-file=.env --experimental-vm-modules node_modules/jest/bin/jest.js --watch --runInBand"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.0.0",
    "socket.io": "^4.7.2"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "socket.io-client": "^4.7.2",
    "supertest": "^6.3.4"
  }
}
