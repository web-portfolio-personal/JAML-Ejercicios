{
  "name": "bildyapp-api",
  "version": "1.0.0",
  "description": "BildyApp API - Gestión de usuarios con Node.js, Express 5 y MongoDB",
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file=.env src/index.js",
    "start": "node --env-file=.env src/index.js",
    "test:server": "node --env-file=.env --env-file=.env.test src/index.js",
    "test": "node --env-file=.env --env-file=.env.test --test tests/api.test.js"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.15.0",
    "multer": "^1.4.5-lts.2",
    "zod": "^3.24.0"
  }
}
