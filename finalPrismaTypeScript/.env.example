NODE_ENV=development
PORT=3000
PUBLIC_URL=http://localhost:3000

# ── Base de datos ─────────────────────────────────────────────────────────────
# Supabase/PostgreSQL (produccion):
# Session pooler (puerto 5432) — compatible con Prisma + pgbouncer
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# SQLite (dev/test local — cambiar provider en schema.prisma a "sqlite"):
# DATABASE_URL=file:./prisma/dev.db

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=<min_32_chars_secret>
JWT_REFRESH_SECRET=<min_32_chars_different_secret>
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Cloudinary ────────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=<tu_cloud_name>
CLOUDINARY_API_KEY=<tu_api_key>
CLOUDINARY_API_SECRET=<tu_api_secret>

# ── Nodemailer (SMTP) ─────────────────────────────────────────────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=<tu_email@gmail.com>
MAIL_PASS=<tu_app_password>
MAIL_FROM="BildyApp <noreply@bildyapp.com>"

# ── Slack (Webhook para logs de errores 5XX) ──────────────────────────────────
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/<tu_webhook>
